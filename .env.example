# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string (required)
# e.g. postgres://user:password@localhost:5432/berciimart
DATABASE_URL=postgres://user:password@localhost:5432/berciimart

# HTTP port the server listens on (defaults to 8080)
PORT=8080

# Comma-separated list of email addresses promoted to ADMIN at login.
# There is no public registration path to ADMIN.
ADMIN_EMAILS=admin@example.com
