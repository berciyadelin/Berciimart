{
    "tasks": [
        {
            "type": "shell",
            "label": "Berciimart: Build Complete Project",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-std=c++17",

                "-I${workspaceFolder}/include",
                "-I C:\\msys64\\ucrt64\\include",

                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/database.cpp",
                "${workspaceFolder}/src/repository/OrderRepository.cpp",

                "-L C:\\msys64\\ucrt64\\lib",
                "-lpq",
                "-largon2",

                "-o",
                "${workspaceFolder}/build/berciimart.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build complete Berciimart project using MSYS2 UCRT64 g++"
        }
    ],
    "version": "2.0.0"
}